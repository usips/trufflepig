{
  "schemaVersion": 1,
  "name": "trufflepig-agent",
  "displayName": "Trufflepig Agent",
  "version": "0.1.0",
  "description": "Repository search, shared plan coordination, and structured agent feedback.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "trufflepig-code-search",
        "path": "skills/trufflepig-code-search/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "trufflepig-plan-board",
        "path": "skills/trufflepig-plan-board/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "trufflepig-steer-search",
        "event": "PreToolUse",
        "command": ["python3", "hooks/steer-search.py", "muse"],
        "timeoutMs": 3000,
        "statusMessage": "Steering search toward trufflepig-agent"
      },
      {
        "id": "trufflepig-session-start",
        "event": "SessionStart",
        "command": ["sh", "hooks/session-start.sh", "muse", "start"],
        "timeoutMs": 2000,
        "statusMessage": "Recording trufflepig audit session"
      },
      {
        "id": "trufflepig-session-end",
        "event": "SessionEnd",
        "command": ["sh", "hooks/session-start.sh", "muse", "end"],
        "timeoutMs": 2000,
        "statusMessage": "Closing trufflepig audit session"
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
