#!/usr/bin/env python3
"""Audited harness wrapper: inject compact output, client, session, and diagnostics.

Explicit CLI options win. Preserve stdout, stderr, and exit code while logging
bounded per-call metadata to the state directory or configured runtime fallback.
Usage: trufflepig-agent [trufflepig options] COMMAND [ARGS...]
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

from trufflepig_runtime import client_environment, fallback_root, steering_mode
from trufflepig_audit_response import coverage_summary, parse_lines_response
from trufflepig_board_audit import BOARD_VERBS, FEEDBACK_REPORT_KINDS, PRIVATE_OPTIONS, audit_arguments, audit_options, error_prefix, recent_calls
from trufflepig_board_notices import (claim_pending_notices, pending_after,
                                     pending_metadata, pending_reply_from_json,
                                     should_poll_pending)

SLOW_SECONDS = 3.0
RECENT_LIMIT = 8
PENDING_LIMIT = 8
PENDING_TIMEOUT_SECONDS = 2.5
TRUFFLEPIG = os.environ.get("TRUFFLEPIG_BINARY", "trufflepig")
FLAGS_WITH_VALUES = {
    "--root", "--workspace", "--member", "--cache", "-b", "--budget", "-n",
    "--limit", "--history-cache", "--target", "--side", "--ignore-revs-file",
    "--diagnostics", "--session", "--client", "--format",
    "--body", "--plan", "--to", "--supersedes", "--scope", "--section",
    "--for", "--project", "--after", "--through", "--worker", "--role", "--model", "--effort",
    "--files", "--head", "--step", "--tests", "--gate", "--eta", "--verdict",
    "--agent-model", "--agent-effort", "--recent-calls", "--board-text", "--board",
}
HARNESS_LABEL = re.compile(r"[a-z][a-z0-9_-]{0,31}\Z")
# Board subverbs the lifecycle hooks run; audited as "hook:VERB" so agent recent-call lists skip them.
HOOK_BOARD_VERBS = {"pending", "bye"}


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return Path(base) / "trufflepig"


def log_dir() -> Path:
    return Path(os.environ.get("TRUFFLEPIG_AGENT_LOG_DIR") or state_dir() / "agent-audit")


def native_markers() -> list[str]:
    """Harnesses whose native environment markers are present, in priority order."""
    marked = []
    if os.environ.get("GEMINI_CLI") == "1":
        marked.append("gemini")
    if os.environ.get("GROK_SESSION_ID"):
        marked.append("grok")
    # omp's shell tool exports CLAUDECODE=1 alongside OMPCODE=1, so omp must be
    # ordered before Claude or every omp call would be attributed to Claude.
    if os.environ.get("OMPCODE") == "1":
        marked.append("omp")
    if os.environ.get("OPENCODE") == "1":
        marked.append("opencode")
    if os.environ.get("CLAUDECODE") == "1" or os.environ.get("CLAUDE_CODE_CHILD_SESSION") == "1":
        marked.append("claude")
    if any(os.environ.get(key) for key in ("CODEX_THREAD_ID", "CODEX_SESSION_ID", "CODEX_VERSION")):
        marked.append("codex")
    # Only the documented session variables mark Kimi and Muse; other names under
    # those prefixes, such as API keys or model settings, do not.
    if os.environ.get("KIMI_SESSION_ID"):
        marked.append("kimi")
    if os.environ.get("MUSE_SESSION_ID"):
        marked.append("muse")
    return marked


def harness_for_process(comm: str) -> str | None:
    lowered = comm.lower()
    if lowered == "grok" or lowered.startswith("grok-"):
        return "grok"
    if lowered == "claude":
        return "claude"
    if lowered == "codex" or lowered.startswith("codex-"):
        return "codex"
    if lowered == "omp":
        return "omp"
    if lowered == "opencode":
        return "opencode"
    if lowered.startswith("kimi"):
        return "kimi"
    if lowered.startswith("muse"):
        return "muse"
    return None


def ancestor_comms() -> list[str]:
    """Process names from the parent upward, bounded like the Rust resolver."""
    names: list[str] = []
    pid = os.getppid()
    for _ in range(12):
        try:
            comm = Path(f"/proc/{pid}/comm").read_text().strip()
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        names.append(comm)
        try:
            pid = int(stat.rsplit(")", 1)[1].split()[1])
        except (IndexError, ValueError):
            break
        if pid <= 1:
            break
    return names


def detect_native_harness() -> str | None:
    """Match the Rust resolver: the nearest ancestor naming a marked harness wins,
    then the first marker in priority order, then the nearest recognized ancestor."""
    marked = native_markers()
    ancestors = [harness for harness in map(harness_for_process, ancestor_comms()) if harness]
    for harness in ancestors:
        if harness in marked:
            return harness
    if marked:
        return marked[0]
    return ancestors[0] if ancestors else None


def detect_harness(explicit_client: str | None = None) -> str:
    """Resolve observed identity before wrapper hints and user client claims."""
    native = detect_native_harness()
    if native:
        return native
    hint = os.environ.get("TRUFFLEPIG_AGENT_HARNESS", "")
    if HARNESS_LABEL.fullmatch(hint):
        return hint
    if isinstance(explicit_client, str) and HARNESS_LABEL.fullmatch(explicit_client):
        return explicit_client
    return "cli"


def cwd_key(cwd: str) -> str:
    """Return a bounded directory key for local recent-query state."""
    return hashlib.sha256(cwd.encode()).hexdigest()[:12]


def resolve_session(harness: str) -> str | None:
    explicit = os.environ.get("TRUFFLEPIG_SESSION")
    if explicit:
        return explicit
    # Gemini's shell does not export its hook-only session ID; use it only when
    # an integration supplies it to this process.
    keys = {
        "gemini": ("GEMINI_SESSION_ID",),
        "grok": ("GROK_SESSION_ID",),
        "omp": ("TRUFFLEPIG_OMP_SESSION",),
        "opencode": ("TRUFFLEPIG_OPENCODE_SESSION",),
        "claude": ("TRUFFLEPIG_CLAUDE_SESSION",),
        "codex": ("CODEX_THREAD_ID", "CODEX_SESSION_ID"),
        "kimi": ("KIMI_SESSION_ID",),
        "muse": ("MUSE_SESSION_ID",),
    }
    for key in (*keys.get(harness, ()), "AGENT_SESSION_ID"):
        if os.environ.get(key):
            return os.environ[key]
    return None


def split_args(argv: list[str]) -> tuple[list[str], str, list[str], dict[str, str]]:
    """Return (options, verb, words, option values) without altering argv."""
    options: list[str] = []
    values: dict[str, str] = {}
    words: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            words.extend(argv[index + 1:])
            break
        if arg.startswith("-") and len(arg) > 1:
            if "=" in arg and arg.startswith("--"):
                name, value = arg.split("=", 1)
                values[name] = value
                options.append(arg)
            elif arg in FLAGS_WITH_VALUES and index + 1 < len(argv):
                values[arg] = argv[index + 1]
                options.extend(argv[index:index + 2])
                index += 1
            elif arg.startswith("-b") and not arg.startswith("--"):
                values["-b"] = arg[2:]
                options.append(arg)
            elif arg.startswith("-n") and not arg.startswith("--"):
                values["-n"] = arg[2:]
                options.append(arg)
            else:
                options.append(arg)
            index += 1
            continue
        words.append(arg)
        index += 1
    # Unknown first words are recorded verbatim so usage errors stay visible.
    verb = words[0] if words else "status"
    return options, verb, words, values


def recent_fingerprints(path: Path) -> list[str]:
    try:
        return path.read_text().split()[-RECENT_LIMIT:]
    except OSError:
        return []


def board_notice_state_dir(harness: str) -> Path:
    """Use the same Claude state directory as Claude's PostToolUse hooks."""
    suffix = "claude-notices" if harness == "claude" else "board-notices"
    return state_dir() / suffix


def delivers_pending_notices(harness: str, values: dict[str, str]) -> bool:
    """Only an explicit session may poll notices as a Claude actor.

    Claude subagent shells inherit the parent's session, and PostToolUse hooks own
    Claude delivery; an inherited session must not claim the parent's notices.
    """
    if harness != "claude":
        return True
    return bool(os.environ.get("TRUFFLEPIG_SESSION")) or "--session" in values


def successful_output(stdout: bytes, stderr: bytes, exit_code: int,
                      argv: list[str], verb: str, words: list[str]) -> dict | None:
    """Return a successful object response, or None for errors/help/text output."""
    if exit_code != 0 or "--help" in argv or "-h" in argv:
        return None
    if "--version" in argv or words[:1] == ["help"]:
        return None
    wants_json = "--json" in argv or any(
        arg == "--format=json" or
        (arg == "--format" and index + 1 < len(argv) and argv[index + 1] == "json")
        for index, arg in enumerate(argv))
    if not stdout.strip():
        if wants_json or error_prefix(stderr.decode("utf-8", "replace")):
            return None
        return {"_text_output": True}
    try:
        parsed = json.loads(stdout)
    except (ValueError, UnicodeDecodeError):
        if wants_json:
            return None
        lowered = stdout.lstrip().lower()
        if lowered.startswith((b"usage:", b"error:", b"help:")):
            return None
        if error_prefix(stderr.decode("utf-8", "replace")):
            return None
        return {"_text_output": True}
    if not isinstance(parsed, dict) or parsed.get("error") is not None:
        return None
    if parsed.get("status") not in (None, "ok"):
        return None
    result = parsed.get("result")
    if isinstance(result, dict) and result.get("result") in ("error", "failed"):
        return None
    return parsed


def poll_board_notices(harness: str, session: str,
                       explicit_session: str | None = None) -> tuple[dict, list[dict]] | None:
    """Make one bounded Pending request and reserve newly addressed notices."""
    actor = f"{harness}/{session}"
    state = board_notice_state_dir(harness)
    try:
        if not should_poll_pending(actor=actor, state_dir=state):
            return None
        after = pending_after(actor, state)
        command = [TRUFFLEPIG, "--json", "--client", harness,
                   "--limit", str(PENDING_LIMIT)]
        if explicit_session is not None:
            command.extend(["--session", explicit_session])
        command.extend(["board", "pending"])
        if after is not None:
            command.append(str(after))
        result = subprocess.run(command, capture_output=True, check=False,
                                 env=client_environment(), timeout=PENDING_TIMEOUT_SECONDS)
        if result.returncode != 0:
            return None
        response = json.loads(result.stdout)
        pending = pending_reply_from_json(response)
        if pending is None:
            return None
        notices = claim_pending_notices(actor=actor, pending=pending, state_dir=state)
        return (pending, notices) if notices else None
    except (OSError, ValueError, UnicodeDecodeError, subprocess.TimeoutExpired):
        return None


def append_pending_output(stdout: bytes, parsed: dict,
                          pending: dict, notices: list[dict]) -> bytes:
    """Attach a small JSON projection or one fixed line footer."""
    metadata = pending_metadata(pending=pending, notices=notices)
    if metadata is None:
        return stdout
    if "_text_output" not in parsed:
        if "board_pending" in parsed:
            return stdout
        parsed["board_pending"] = metadata
        newline = b"\n" if stdout.endswith(b"\n") else b""
        try:
            encoded = json.dumps(parsed, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        except (TypeError, ValueError, UnicodeEncodeError):
            return stdout
        return encoded + newline
    count = len(notices)
    footer = (f"board: {count} pending notice{'s' if count != 1 else ''}; "
              "run trufflepig-agent board pending\n").encode("utf-8")
    return stdout + (b"" if not stdout or stdout.endswith(b"\n") else b"\n") + footer


def main() -> int:
    argv = sys.argv[1:]
    cwd = os.getcwd()
    options, verb, words, values = split_args(argv)
    native_harness = detect_native_harness()
    claimed_client_arg = values.get("--client")
    claimed_client = (claimed_client_arg if isinstance(claimed_client_arg, str)
                      and HARNESS_LABEL.fullmatch(claimed_client_arg) else None)
    hint = os.environ.get("TRUFFLEPIG_AGENT_HARNESS", "")
    if native_harness:
        harness, identity_source = native_harness, "observed"
    elif HARNESS_LABEL.fullmatch(hint):
        harness, identity_source = hint, "wrapper_hint"
    elif claimed_client is not None:
        harness, identity_source = claimed_client, "client_claim"
    else:
        harness, identity_source = "cli", "cli"
    session = (values["--session"] if "--session" in values
               else resolve_session(harness))
    private_audit = verb in BOARD_VERBS or bool(PRIVATE_OPTIONS & values.keys())
    injected: list[str] = []
    if "--json" not in options and "--format" not in values:
        injected.extend(["--format", "lines"])
    if "--client" not in values:
        injected.extend(["--client", harness])
    if "--diagnostics" not in values:
        injected.extend(["--diagnostics", os.environ.get("TRUFFLEPIG_AGENT_DIAGNOSTICS", "detailed")])
    runtime = fallback_root()
    if verb in BOARD_VERBS:
        for flag, key in (("--agent-model", "TRUFFLEPIG_AGENT_MODEL"),
                          ("--agent-effort", "TRUFFLEPIG_AGENT_EFFORT")):
            if flag not in values and os.environ.get(key):
                injected.extend([flag, os.environ[key]])
    feedback_report = verb == "feedback" and len(words) > 1 and words[1] in FEEDBACK_REPORT_KINDS
    if feedback_report and session and "--recent-calls" not in values:
        injected.extend(["--recent-calls", recent_calls([log_dir(), runtime / "agent-audit"], harness, session)])
    command = [TRUFFLEPIG, *injected, *argv]
    environment = client_environment()
    if feedback_report:
        environment["TRUFFLEPIG_AGENT_STEER"] = steering_mode(harness)

    started = time.monotonic()
    try:
        completed = subprocess.run(command, capture_output=True, check=False, env=environment)
        exit_code = completed.returncode
        stdout, stderr = completed.stdout, completed.stderr
    except FileNotFoundError:
        exit_code = 127
        stdout = b""
        stderr = f"trufflepig-agent: {TRUFFLEPIG} not found on PATH\n".encode()
    elapsed = time.monotonic() - started

    response: dict = {}
    if stdout.lstrip().startswith(b"{"):
        try:
            first_line = stdout.split(b"\n", 1)[0]
            parsed = json.loads(first_line) if first_line.strip() else {}
            response = parsed if isinstance(parsed, dict) else {}
        except (ValueError, UnicodeDecodeError):
            response = {}
    elif stdout.strip():
        response = parse_lines_response(stdout)

    visible_stdout = stdout
    is_pending_query = verb == "board" and len(words) > 1 and words[1] == "pending"
    hook_call = (os.environ.get("TRUFFLEPIG_AGENT_HOOK") == "1" and verb == "board"
                 and len(words) > 1 and words[1] in HOOK_BOARD_VERBS)
    audit_verb = f"hook:{words[1]}" if hook_call else verb
    parsed_success = successful_output(stdout, stderr, exit_code, argv, verb, words)
    if (session and parsed_success is not None and not is_pending_query and not hook_call
            and delivers_pending_notices(harness, values)
            and "board_pending" not in parsed_success):
        pending_result = poll_board_notices(harness, session, values.get("--session"))
        if pending_result is not None:
            pending, notices = pending_result
            visible_stdout = append_pending_output(stdout, parsed_success, pending, notices)

    sys.stdout.buffer.write(visible_stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(stderr)
    sys.stderr.buffer.flush()

    hits = response.get("hits")
    hit_count = len(hits) if isinstance(hits, list) else None
    status = response.get("status") or ("ok" if exit_code == 0 else "error")
    error_text = ""
    if isinstance(response.get("error"), str):
        error_text = response["error"]
    stderr_head = stderr.decode("utf-8", "replace").strip()[:300]
    coverage = coverage_summary(response)

    fingerprint = hashlib.blake2s(" ".join([verb, *words[1:]]).encode(), digest_size=8).hexdigest()
    recent_path = (state_dir() / "agent-recent" / harness / f"{cwd_key(cwd)}-{session}"
                   if session else None)
    audit_fallback = runtime / "agent-audit"
    recent_fallback = (runtime / "agent-recent" / recent_path.parent.name / recent_path.name
                       if recent_path is not None else None)
    if recent_path is not None:
        try:
            recent = recent_path.read_text().split()[-RECENT_LIMIT:]
        except OSError:
            recent = recent_fingerprints(recent_fallback)
    else:
        recent = []
    repeat_count = recent.count(fingerprint)

    signals: list[str] = []
    lowered = (error_text + " " + stderr_head).lower()
    if exit_code != 0 or status not in ("ok",):
        signals.append("error")
    # Hit-list verbs report an empty page; `show` reports a missing definition as an error.
    if (verb in ("search", "refs", "map") and hit_count == 0 and exit_code == 0
            or verb == "show" and "no_definition" in lowered):
        signals.append("no_hits")
    if response.get("truncated") is True:
        signals.append("truncated")
    if "budget" in lowered:
        signals.append("budget")
    if any(key in lowered for key in ("stale_result", "stale_source", "expired_result")):
        signals.append("stale")
    if "unknown_command" in lowered or "invalid_query" in lowered or "usage" in lowered:
        signals.append("usage_error")
    if any(m.get("semantic_status") in ("unavailable", "partial") for m in coverage.values()):
        signals.append("semantic_degraded")
    if any(m.get("rerank_status") == "unavailable" for m in coverage.values()):
        signals.append("rerank_unavailable")
    if elapsed > SLOW_SECONDS:
        signals.append("slow")
    if repeat_count >= 1 and verb in ("search", "refs", "map"):
        signals.append("repeat_query")

    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "ts_ns": time.time_ns(),
        "harness": harness,
        "origin_harness": harness,
        "identity_source": identity_source,
        "claimed_client": claimed_client,
        "session": session,
        "cwd": cwd,
        "verb": audit_verb,
        "args": audit_arguments(verb, words[1:]),
        "options": audit_options(verb, values),
        "exit_code": exit_code,
        "elapsed_ms": int(elapsed * 1000),
        "status": status,
        "error": error_prefix(error_text) if private_audit else error_text[:300],
        "stderr": error_prefix(stderr_head) if private_audit else stderr_head,
        "hits": hit_count,
        "truncated": response.get("truncated"),
        "has_next": bool(response.get("next")),
        "stdout_bytes": len(stdout),
        "coverage": coverage,
        "repeat_count": repeat_count,
        "signals": signals,
    }
    def append_audit(log_target: Path) -> None:
        log_target.mkdir(parents=True, exist_ok=True)
        with (log_target / f"{harness}.jsonl").open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, separators=(",", ":")) + "\n")

    def write_recent(recent_file: Path) -> None:
        recent_file.parent.mkdir(parents=True, exist_ok=True)
        recent_file.write_text(" ".join([*recent, fingerprint][-RECENT_LIMIT:]))

    def with_fallback(write, primary: Path, fallback: Path) -> OSError | None:
        try:
            write(primary)
            return None
        except OSError:
            try:
                write(fallback)
                return None
            except OSError as fallback_error:
                return fallback_error

    audit_error = with_fallback(append_audit, log_dir(), audit_fallback)
    if recent_path is not None and recent_fallback is not None:
        with_fallback(write_recent, recent_path, recent_fallback)
    if audit_error is not None:
        sys.stderr.write(f"trufflepig-agent: audit log unavailable: {audit_error}\n")
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
